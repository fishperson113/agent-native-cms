{
  "name": "agent-native-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests scripts next.config.ts postcss.config.mjs eslint.config.mjs drizzle.config.ts vitest.config.ts vitest.integration.config.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "demo:terminal": "vitest run --config vitest.integration.config.ts tests/integration/article-lifecycle.acceptance.test.ts --reporter=verbose",
    "demo:mcp": "vitest run --config vitest.integration.config.ts tests/integration/mcp-article-tools.acceptance.test.ts --reporter=verbose",
    "demo:presentation-core": "vitest run --config vitest.integration.config.ts tests/integration/presentation-upload.acceptance.test.ts --reporter=verbose",
    "demo:presentation-mcp": "vitest run --config vitest.integration.config.ts tests/integration/mcp-article-tools.acceptance.test.ts --reporter=verbose",
    "demo:reliability": "vitest run --config vitest.integration.config.ts tests/integration/reliability.acceptance.test.ts --reporter=verbose",
    "demo:delivery": "vitest run --config vitest.integration.config.ts tests/integration/http-mcp.acceptance.test.ts tests/integration/public-delivery.acceptance.test.ts --reporter=verbose",
    "demo:stateful-mcp": "vitest run --config vitest.integration.config.ts tests/integration/http-mcp.acceptance.test.ts --reporter=verbose",
    "demo:credentials": "vitest run --config vitest.integration.config.ts tests/integration/mcp-credentials.acceptance.test.ts tests/integration/http-mcp.acceptance.test.ts --reporter=verbose",
    "demo:authorization": "vitest run --config vitest.integration.config.ts tests/integration/admin-control-plane.acceptance.test.ts tests/integration/http-mcp.acceptance.test.ts --reporter=verbose",
    "demo:audit": "vitest run --config vitest.integration.config.ts tests/integration/audit-event-stream.acceptance.test.ts tests/integration/http-mcp.acceptance.test.ts --reporter=verbose",
    "mcp:stdio": "tsx src/integrations/mcp/stdio-server.ts",
    "mcp:admin": "tsx scripts/manage-mcp.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infrastructure/database/migrate.ts",
    "db:seed": "tsx src/infrastructure/database/seed.ts",
    "db:seed:delivery": "tsx scripts/seed-delivery-demo.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.2",
    "next": "16.3.3",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.28.2"
}
